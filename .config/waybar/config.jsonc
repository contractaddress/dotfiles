{
    "layer": "top",
    "position": "top",
    "margin": "0",
    "spacing": 0,
    "height": 26,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["tray"],
    "modules-right": ["mpd","pulseaudio","memory","cpu","clock"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },


    "clock": {
        "format": "{:%H:%M} ",
        "tooltip-format": "{:%A, %B %d}"
    },

    "memory": {
        "format": "{used:0.1f}G {icon}",
        "format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
        "interval": 5
    },


    "mpd": {
        "format": "{volume}% {stateIcon} {title} - {artist}",
        "format-stopped": "",
        "on-click": "mpc toggle",
        "on-scroll-up": "mpc volume +5",
        "on-scroll-down": "mpc volume -5",
        "on-click-right": "mpc next"
    },

    "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "󰝟 muted",
    "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
    },

    "max-volume": 100,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },

    "cpu": {
    "interval": 2,
    "format": "{usage}% ",
    "tooltip": true
    },

    "tray": {
    "icon-size": 17,
    "spacing": 10 // Sets spacing between tray icons
    }
}
