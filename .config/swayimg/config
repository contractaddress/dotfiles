[keys.gallery]
Ctrl+c = exec wl-copy '%' && notify-send "Copied image path" -i '%'
Ctrl+f = exec cp '%' ~/Pictures/Favorites/ && notify-send "Added image to Favorites" -i '%'

[keys.viewer]
Ctrl+c = exec wl-copy '%' && notify-send "Copied image path" -i '%'
Ctrl+w = exec swww img '%' --transition-type wipe --transition-duration 1 & wal -i '%' && source ~/.cache/wal/colors.sh && hyprctl keyword general:col.active_border "rgba(${color1:1}ff)"
# Ctrl+Shift+w = exec swww img '%' --transition-type wipe --transition-duration 1 && hellwal -i '%' --neon-mode  
# Ctrl+Alt+w = exec swww img '%' --transition-type wipe --transition-duration 1 && wal -i '%'
Ctrl+f = exec cp '%' ~/Pictures/Favorites/ && notify-send "Added image to Favorites" -i '%'
DELETE = exec rm '%' && notify-send "Image deleted" -i '%'
