[keys.gallery]
Ctrl+c = exec wl-copy '%' && notify-send "Copied image path" '%'
Ctrl+f = exec cp '%' ~/Pictures/Favorites/ && notify-send "Added image to Favorites"

[keys.viewer]
Ctrl+c = exec wl-copy '%' && notify-send "Copied image path" '%'
Ctrl+w = exec swww img '%' --transition-type wipe --transition-duration 1 && hellwal -i '%' --neon-mode
Ctrl+Shift+w = exec swww img '%' --transition-type wipe --transition-duration 1 && hellwal -i '%' --light
Ctrl+Alt+w = exec swww img '%' --transition-type wipe --transition-duration 1 && hellwal -i '%'
Ctrl+f = exec cp '%' ~/Pictures/Favorites/ && notify-send "Added image to Favorites"
