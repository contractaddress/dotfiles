[global]
# Display
follow = mouse
width = (0, 650)
height = (0, 350)
origin = bottom-right
offset = (20, 45)
indicate_hidden = yes
notification_limit = 5
gap_size = 8
padding = 12
horizontal_padding = 16
frame_width = 3
sort = no
# Progress bar
progress_bar_frame_width = 2
progress_bar_corner_radius = 3
# Colors
foreground = "#cdd1dc"
frame_color = "#ffff"
highlight = "#2274d5, #82aad9"
# Text
font = Mononoki Nerd Font 14
markup = full
format = "<small>%a</small>\n<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = -1
hide_duplicate_count = false
# Icon
icon_position = left
min_icon_size = 128
max_icon_size = 128
icon_path = ''
icon_corner_radius = 6
# Misc/Advanced
dmenu = wofi --show drun --prompt 'Open with'
corner_radius = 10
# Mouse
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#383c4a70"
frame_color = "#ffffff12"
timeout = 4

[urgency_normal]
background = "#383c4a80"
frame_color = "#ffffff1a"
timeout = 4

[urgency_critical]
background = "#9b4d4b80"
frame_color = "#eb4d4b55"
highlight = "#eb4d4b"
timeout = 0

# Rules
[fullscreen_delay_everything]
fullscreen = delay

[fullscreen_show_critical]
msg_urgency = critical
fullscreen = show

[telegram]
appname = "Telegram*"
max_icon_size = 42
min_icon_size = 42
format = "<b>%s</b>\n%b"
word_wrap = no
ellipsize = end
height = (0, 100)
