#!/usr/bin/env bash

TERMINAL='/usr/bin/foot'
FOOTFLAGS=(
  -e
  --title FloatingFoot
)

export PATH=$PATH:/usr/local/bin:/usr/bin:/bin:~/.local/bin:~/.local/scripts:

file="$HOME/.config/cmdshelf.list"
[ -f "$file" ] || exit 1

chosen=$(wofi --dmenu <"$file")
[ -z "$chosen" ] && exit 0

# List of keywords that should run directly in zsh
direct_keywords=("swayimg" "template")

run_direct=false
for kw in "${direct_keywords[@]}"; do
  if [[ "$chosen" == *"$kw"* ]]; then
    run_direct=true
    break
  fi
done

if $run_direct; then
  zsh -c "$chosen"
else
  setsid -f "$TERMINAL" "${FOOTFLAGS[@]}" zsh -l -c "$chosen; exec zsh"
fi
