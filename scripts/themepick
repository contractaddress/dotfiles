#!/bin/bash

#helpers
TERM_OPACITY="$HOME/.local/scripts/helpers/term_opacity"
REFRESH_BORDER="$HOME/.local/scripts/helpers/refresh_windowborder"

PREVIEW_DIR="$HOME/.local/share/themepick"
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"

AWWW_FLAGS="--transition-type wipe --transition-duration 1"

# FORMAT:                              transparent/opaque
# name|preview_image|wallpaper|wal_theme|opacity_mode|bordercolor1 bordercolor2
THEMES="
BEARS|$PREVIEW_DIR/gruvbox-material.png|$WALLPAPER_DIR/bears.png|gruvbox-material|transparent|2 6
SEA|$PREVIEW_DIR/countrysideguitar.png|$WALLPAPER_DIR/countryrockstar.jpg|catppuccin|transparent|2 6
ROSEYDUCKS|$PREVIEW_DIR/roseducks.png|$WALLPAPER_DIR/roseyducks.jpg|roseducks|transparent|2 2
TOKYO|$PREVIEW_DIR/tokyo.png|$WALLPAPER_DIR/tokyo.jpg|monokai|transparent|2 6
DIGI|$PREVIEW_DIR/digi3d.png|$WALLPAPER_DIR/digi3d.jpg|neon-star|transparent|2 6
BLACK|$PREVIEW_DIR/dark-gruv.png|$WALLPAPER_DIR/darkBG.png|dark-gruv|transparent|3 11
"

# Build wofi input
WOFI_INPUT=$(echo "$THEMES" | while IFS='|' read -r name preview _; do
    [ -z "$name" ] && continue
    echo "img:$preview:text:$name"
done)

CHOICE=$(echo "$WOFI_INPUT" | wofi \
    -I \
    --dmenu \
    --cache-file=/dev/null \
    -Dimage_size=300 \
    -p 'choose theme' \
    -W 800 \
    --conf "$HOME/.config/wofi/themepicker/thempick.conf" \
    --style "$HOME/.config/wofi/themepicker/themepicker.css"
)

CHOICE=$(echo "$CHOICE" | sed 's|img:[^:]*:text:||')

# Apply selected theme
echo "$THEMES" | while IFS='|' read -r name preview wallpaper wal_theme opacity border; do
    [ "$name" != "$CHOICE" ] && continue

    awww img "$wallpaper" $AWWW_FLAGS
    wal --theme "$wal_theme"
    "$TERM_OPACITY" "$opacity"

    set -- $border
    "$REFRESH_BORDER" "$1" "$2"

    break
done
